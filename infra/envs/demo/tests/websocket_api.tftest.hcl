# Executable checks of the websocket-api module (design section 6.2): the stage throttles, the
# logging that stays off (the $connect query string carries the token), the $connect route with its
# explicit NONE authorization, and exactly three invocation permissions, one per route. Mocked
# provider: no credentials and no AWS call.

mock_provider "aws" {}

variables {
  name_prefix = "mfc-demo"
  region      = "eu-west-3"
  routes = {
    connect    = { function_arn = "arn:aws:lambda:eu-west-3:123456789012:function:mfc-demo-ws-connect", function_name = "mfc-demo-ws-connect" }
    disconnect = { function_arn = "arn:aws:lambda:eu-west-3:123456789012:function:mfc-demo-ws-disconnect", function_name = "mfc-demo-ws-disconnect" }
    default    = { function_arn = "arn:aws:lambda:eu-west-3:123456789012:function:mfc-demo-ws-message", function_name = "mfc-demo-ws-message" }
  }
}

# The API id is generated by AWS; the plan needs it to build the ARNs under test.
override_resource {
  target          = aws_apigatewayv2_api.this
  override_during = plan
  values = {
    id            = "a1b2c3d4e5"
    execution_arn = "arn:aws:execute-api:eu-west-3:123456789012:a1b2c3d4e5"
    api_endpoint  = "wss://a1b2c3d4e5.execute-api.eu-west-3.amazonaws.com"
  }
}

run "api_is_a_websocket_api_that_routes_on_the_type_field" {
  command = plan

  module {
    source = "../../modules/websocket-api"
  }

  assert {
    condition     = aws_apigatewayv2_api.this.protocol_type == "WEBSOCKET" && aws_apigatewayv2_api.this.route_selection_expression == "$request.body.type"
    error_message = "the API must be a WEBSOCKET API routed on $request.body.type"
  }
}

run "stage_keeps_every_log_and_trace_off" {
  command = plan

  module {
    source = "../../modules/websocket-api"
  }

  assert {
    condition     = aws_apigatewayv2_stage.this.default_route_settings[0].logging_level == "OFF" && !aws_apigatewayv2_stage.this.default_route_settings[0].data_trace_enabled && !aws_apigatewayv2_stage.this.default_route_settings[0].detailed_metrics_enabled
    error_message = "the default route settings must keep logging, data trace and detailed metrics off"
  }

  assert {
    condition     = length(aws_apigatewayv2_stage.this.access_log_settings) == 0
    error_message = "the stage must not write access logs: the query string of $connect carries the token (THREAT_MODEL T25)"
  }

  assert {
    condition     = aws_apigatewayv2_stage.this.name == "live" && aws_apigatewayv2_stage.this.auto_deploy
    error_message = "the stage must be live and auto-deployed"
  }
}

run "stage_throttles_connect_and_messages_separately" {
  command = plan

  module {
    source = "../../modules/websocket-api"
  }

  assert {
    condition     = aws_apigatewayv2_stage.this.default_route_settings[0].throttling_rate_limit == 50 && aws_apigatewayv2_stage.this.default_route_settings[0].throttling_burst_limit == 100
    error_message = "messages must be throttled at 50 per second with a burst of 100"
  }

  assert {
    condition     = one([for r in aws_apigatewayv2_stage.this.route_settings : r if r.route_key == "$connect"]).throttling_rate_limit == 10 && one([for r in aws_apigatewayv2_stage.this.route_settings : r if r.route_key == "$connect"]).throttling_burst_limit == 20
    error_message = "$connect must be throttled at 10 per second with a burst of 20 (THREAT_MODEL R40)"
  }
}

run "connect_route_has_no_authorizer_because_the_function_checks_the_token" {
  command = plan

  module {
    source = "../../modules/websocket-api"
  }

  assert {
    condition     = aws_apigatewayv2_route.connect.route_key == "$connect" && aws_apigatewayv2_route.connect.authorization_type == "NONE"
    error_message = "$connect must be explicitly NONE: the token is checked by ws-connect"
  }
}

run "exactly_three_invocation_permissions_one_per_route" {
  command = plan

  module {
    source = "../../modules/websocket-api"
  }

  assert {
    condition     = aws_lambda_permission.connect.function_name == "mfc-demo-ws-connect" && aws_lambda_permission.disconnect.function_name == "mfc-demo-ws-disconnect" && aws_lambda_permission.default.function_name == "mfc-demo-ws-message"
    error_message = "each route must invoke its own function and no other"
  }

  assert {
    condition     = alltrue([for p in [aws_lambda_permission.connect, aws_lambda_permission.disconnect, aws_lambda_permission.default] : p.principal == "apigateway.amazonaws.com" && p.action == "lambda:InvokeFunction"])
    error_message = "every permission must let API Gateway invoke the function and nothing else"
  }

  assert {
    condition     = aws_lambda_permission.connect.source_arn == "arn:aws:execute-api:eu-west-3:123456789012:a1b2c3d4e5/*/$connect" && aws_lambda_permission.disconnect.source_arn == "arn:aws:execute-api:eu-west-3:123456789012:a1b2c3d4e5/*/$disconnect" && aws_lambda_permission.default.source_arn == "arn:aws:execute-api:eu-west-3:123456789012:a1b2c3d4e5/*/$default"
    error_message = "every permission must be bound to this API and its route only"
  }
}

run "outputs_give_the_endpoints_and_the_stage_arn" {
  command = plan

  module {
    source = "../../modules/websocket-api"
  }

  assert {
    condition     = output.ws_url == "wss://a1b2c3d4e5.execute-api.eu-west-3.amazonaws.com/live" && output.management_endpoint == "https://a1b2c3d4e5.execute-api.eu-west-3.amazonaws.com/live"
    error_message = "the WSS and HTTPS endpoints must name the API and the live stage"
  }

  assert {
    condition     = output.stage_arn == "arn:aws:execute-api:eu-west-3:123456789012:a1b2c3d4e5/live"
    error_message = "the stage ARN must be the API execution ARN and the stage name"
  }
}
