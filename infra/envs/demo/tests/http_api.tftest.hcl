# Executable checks of the http-api module (M6, ADR 0047): the JWT authorizer on every route except
# health, the CORS allow-list without a wildcard, the stage throttles, the access log format without
# any credential-bearing field, and one invocation permission per route bound to its method and path.
# Mocked provider: no credentials and no AWS call.

mock_provider "aws" {}

variables {
  name_prefix         = "mfc-demo"
  console_origin      = "https://d111111abcdef8.cloudfront.net"
  user_pool_endpoint  = "https://cognito-idp.eu-west-3.amazonaws.com/eu-west-3_AbCdEf123"
  user_pool_client_id = "1a2b3c4d5e6f7g8h9i0jk1l2m3"
  alarm_topic_arn     = "arn:aws:sns:eu-west-3:123456789012:mfc-demo-alarms"
  routes = {
    health = {
      method         = "GET"
      path           = "/health"
      function_arn   = "arn:aws:lambda:eu-west-3:123456789012:function:mfc-demo-health"
      function_name  = "mfc-demo-health"
      authorized     = false
      throttle_rate  = 10
      throttle_burst = 20
    }
    me = {
      method        = "GET"
      path          = "/me"
      function_arn  = "arn:aws:lambda:eu-west-3:123456789012:function:mfc-demo-me"
      function_name = "mfc-demo-me"
      authorized    = true
    }
    ws_token = {
      method         = "POST"
      path           = "/ws-token"
      function_arn   = "arn:aws:lambda:eu-west-3:123456789012:function:mfc-demo-ws-token-http"
      function_name  = "mfc-demo-ws-token-http"
      authorized     = true
      throttle_rate  = 5
      throttle_burst = 10
    }
  }
}

# The API id is generated by AWS; the plan needs it to build the ARNs under test.
override_resource {
  target          = aws_apigatewayv2_api.this
  override_during = plan
  values = {
    id            = "a1b2c3d4e5"
    execution_arn = "arn:aws:execute-api:eu-west-3:123456789012:a1b2c3d4e5"
    api_endpoint  = "https://a1b2c3d4e5.execute-api.eu-west-3.amazonaws.com"
  }
}

# The authorizer id is generated by AWS and is read by the route assertions.
override_resource {
  target          = aws_apigatewayv2_authorizer.jwt
  override_during = plan
  values          = { id = "9z8y7x6w5v" }
}

override_resource {
  target          = aws_cloudwatch_log_group.access
  override_during = plan
  values          = { arn = "arn:aws:logs:eu-west-3:123456789012:log-group:/aws/apigateway/mfc-demo-http" }
}

run "every_route_but_health_requires_a_jwt" {
  command = plan

  module {
    source = "../../modules/http-api"
  }

  assert {
    condition     = alltrue([for key, route in aws_apigatewayv2_route.this : key == "health" ? route.authorization_type == "NONE" && route.authorizer_id == null : route.authorization_type == "JWT" && route.authorizer_id != null])
    error_message = "every route except health must use the JWT authorizer, and only health may be unauthenticated"
  }

  assert {
    condition     = aws_apigatewayv2_authorizer.jwt.authorizer_type == "JWT" && contains(aws_apigatewayv2_authorizer.jwt.identity_sources, "$request.header.Authorization")
    error_message = "the authorizer must read the bearer token from the Authorization header"
  }

  assert {
    condition     = contains(aws_apigatewayv2_authorizer.jwt.jwt_configuration[0].audience, "1a2b3c4d5e6f7g8h9i0jk1l2m3") && aws_apigatewayv2_authorizer.jwt.jwt_configuration[0].issuer == "https://cognito-idp.eu-west-3.amazonaws.com/eu-west-3_AbCdEf123"
    error_message = "the authorizer must validate the issuer of the user pool and the audience of the console client"
  }
}

run "cors_allows_the_console_origin_only_by_default" {
  command = plan

  module {
    source = "../../modules/http-api"
  }

  assert {
    condition     = length(aws_apigatewayv2_api.this.cors_configuration[0].allow_origins) == 1 && contains(aws_apigatewayv2_api.this.cors_configuration[0].allow_origins, "https://d111111abcdef8.cloudfront.net")
    error_message = "CORS must allow the console origin only, with no wildcard and no dev origin by default"
  }

  assert {
    condition     = !aws_apigatewayv2_api.this.cors_configuration[0].allow_credentials && aws_apigatewayv2_api.this.cors_configuration[0].max_age == 600
    error_message = "CORS must not allow credentials, and the preflight cache must last 600 seconds"
  }
}

run "stage_throttles_the_default_and_the_abusable_routes" {
  command = plan

  module {
    source = "../../modules/http-api"
  }

  assert {
    condition     = aws_apigatewayv2_stage.default.name == "$default" && aws_apigatewayv2_stage.default.auto_deploy && aws_apigatewayv2_stage.default.default_route_settings[0].throttling_rate_limit == 25 && aws_apigatewayv2_stage.default.default_route_settings[0].throttling_burst_limit == 50
    error_message = "the stage must be auto-deployed with the default throttles of 25 per second and a burst of 50"
  }
}

# The per-route throttles (GET /health, POST /ws-token) live in a dynamic block whose elements the
# plan cannot read with the mocked provider; they are reviewed in the plan output of the deploy workflow.

run "access_logs_carry_no_credential_or_client_address" {
  command = plan

  module {
    source = "../../modules/http-api"
  }

  assert {
    condition     = aws_apigatewayv2_stage.default.access_log_settings[0].destination_arn == "arn:aws:logs:eu-west-3:123456789012:log-group:/aws/apigateway/mfc-demo-http"
    error_message = "access logs must go to the API log group"
  }

  assert {
    condition     = !strcontains(aws_apigatewayv2_stage.default.access_log_settings[0].format, "authorization") && !strcontains(aws_apigatewayv2_stage.default.access_log_settings[0].format, "$context.identity") && !strcontains(aws_apigatewayv2_stage.default.access_log_settings[0].format, "$context.path") && !strcontains(aws_apigatewayv2_stage.default.access_log_settings[0].format, "$context.authorizer.claims")
    error_message = "the access log format must not carry the Authorization header, the client address, the path with its query string or the token claims"
  }
}

run "one_invocation_permission_per_route_bound_to_method_and_path" {
  command = plan

  module {
    source = "../../modules/http-api"
  }

  assert {
    condition     = aws_lambda_permission.route["me"].source_arn == "arn:aws:execute-api:eu-west-3:123456789012:a1b2c3d4e5/*/GET/me" && aws_lambda_permission.route["ws_token"].source_arn == "arn:aws:execute-api:eu-west-3:123456789012:a1b2c3d4e5/*/POST/ws-token"
    error_message = "each permission must be bound to the API and to its method and path only"
  }

  assert {
    condition     = alltrue([for p in values(aws_lambda_permission.route) : p.principal == "apigateway.amazonaws.com" && p.action == "lambda:InvokeFunction"])
    error_message = "every permission must let API Gateway invoke the function and nothing else"
  }
}

# The Errors and Throttles alarms of each function live in the lambda-function module (ADR 0023), so this
# module owns the 5xx alarm of the API only.
run "api_5xx_alarm_reaches_the_alarm_topic" {
  command = plan

  module {
    source = "../../modules/http-api"
  }

  assert {
    condition     = aws_cloudwatch_metric_alarm.api_server_errors.metric_name == "5xx" && contains(aws_cloudwatch_metric_alarm.api_server_errors.alarm_actions, "arn:aws:sns:eu-west-3:123456789012:mfc-demo-alarms")
    error_message = "the 5xx alarm must watch the API and notify the alarm topic"
  }
}

run "dev_origin_is_added_only_when_enabled" {
  command = plan

  variables {
    enable_dev_origin = true
  }

  module {
    source = "../../modules/http-api"
  }

  assert {
    condition     = length(aws_apigatewayv2_api.this.cors_configuration[0].allow_origins) == 2 && contains(aws_apigatewayv2_api.this.cors_configuration[0].allow_origins, "http://localhost:5173") && !contains(aws_apigatewayv2_api.this.cors_configuration[0].allow_origins, "*")
    error_message = "the Vite dev origin must be added to the allow-list only when enable_dev_origin is set, and never a wildcard"
  }
}

run "cors_allows_put_for_the_site_configuration" {
  command = plan

  module {
    source = "../../modules/http-api"
  }

  assert {
    condition     = toset(aws_apigatewayv2_api.this.cors_configuration[0].allow_methods) == toset(["GET", "POST", "PUT"])
    error_message = "CORS must allow exactly GET, POST and PUT: PUT is the site configuration (M7)"
  }
}

run "path_parameters_are_accepted_and_authorised_by_wildcard" {
  command = plan

  variables {
    routes = {
      site_get = {
        method        = "GET"
        path          = "/sites/{siteId}"
        function_arn  = "arn:aws:lambda:eu-west-3:123456789012:function:mfc-demo-site"
        function_name = "mfc-demo-site"
        authorized    = true
      }
      site_map_activate = {
        method         = "POST"
        path           = "/sites/{siteId}/maps/{version}/activate"
        function_arn   = "arn:aws:lambda:eu-west-3:123456789012:function:mfc-demo-site"
        function_name  = "mfc-demo-site"
        authorized     = true
        throttle_rate  = 2
        throttle_burst = 5
      }
    }
  }

  module {
    source = "../../modules/http-api"
  }

  assert {
    condition     = aws_lambda_permission.route["site_get"].source_arn == "arn:aws:execute-api:eu-west-3:123456789012:a1b2c3d4e5/*/GET/sites/*" && aws_lambda_permission.route["site_map_activate"].source_arn == "arn:aws:execute-api:eu-west-3:123456789012:a1b2c3d4e5/*/POST/sites/*/maps/*/activate"
    error_message = "a path parameter must be matched by a wildcard in the invocation permission, never by its template"
  }

  assert {
    condition     = aws_apigatewayv2_route.this["site_map_activate"].route_key == "POST /sites/{siteId}/maps/{version}/activate"
    error_message = "the route key keeps the template of the path"
  }
}

run "path_with_an_uppercase_or_underscore_is_refused" {
  command = plan

  variables {
    routes = {
      bad = {
        method        = "GET"
        path          = "/sites/Bad_Id"
        function_arn  = "arn:aws:lambda:eu-west-3:123456789012:function:mfc-demo-site"
        function_name = "mfc-demo-site"
        authorized    = true
      }
    }
  }

  module {
    source = "../../modules/http-api"
  }

  expect_failures = [var.routes]
}
