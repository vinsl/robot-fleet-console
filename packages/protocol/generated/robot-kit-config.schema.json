{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "robotId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,32}$"
    },
    "siteId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,32}$"
    },
    "thingName": {
      "type": "string",
      "pattern": "^mfc-demo-[a-z0-9-]{3,32}$"
    },
    "simulated": {
      "type": "boolean"
    },
    "region": {
      "type": "string",
      "enum": [
        "eu-west-3",
        "eu-west-1"
      ]
    },
    "iotEndpoint": {
      "type": "string",
      "pattern": "^[a-z0-9]+-ats\\.iot\\.(?:eu-west-3|eu-west-1)\\.amazonaws\\.com$"
    },
    "credentialsEndpoint": {
      "type": "string",
      "pattern": "^[a-z0-9]+\\.credentials\\.iot\\.(?:eu-west-3|eu-west-1)\\.amazonaws\\.com$"
    },
    "roleAlias": {
      "type": "string",
      "const": "mfc-demo-robot-kvs-master"
    },
    "kvsChannelName": {
      "type": "string",
      "pattern": "^mfc-demo-[a-z0-9-]{3,32}$"
    },
    "kvsChannelArn": {
      "type": "string",
      "pattern": "^arn:aws:kinesisvideo:(?:eu-west-3|eu-west-1):\\d{12}:channel\\/mfc-demo-[a-z0-9-]{3,32}\\/\\d{1,20}$"
    }
  },
  "required": [
    "robotId",
    "siteId",
    "thingName",
    "simulated",
    "region",
    "iotEndpoint",
    "credentialsEndpoint",
    "roleAlias",
    "kvsChannelName",
    "kvsChannelArn"
  ],
  "additionalProperties": false
}
