{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "robotId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,32}$"
    },
    "region": {
      "type": "string",
      "enum": [
        "eu-west-3",
        "eu-west-1"
      ]
    },
    "channelName": {
      "type": "string",
      "pattern": "^mfc-demo-[a-z0-9-]{3,32}$"
    },
    "channelArn": {
      "type": "string",
      "pattern": "^arn:aws:kinesisvideo:(?:eu-west-3|eu-west-1):\\d{12}:channel\\/mfc-demo-[a-z0-9-]{3,32}\\/\\d{1,20}$"
    },
    "credentials": {
      "type": "object",
      "properties": {
        "accessKeyId": {
          "type": "string",
          "pattern": "^ASIA[A-Z0-9]{16}$"
        },
        "secretAccessKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9/+]{40}$"
        },
        "sessionToken": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/=]{16,8192}$"
        },
        "expiration": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "accessKeyId",
        "secretAccessKey",
        "sessionToken",
        "expiration"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "robotId",
    "region",
    "channelName",
    "channelArn",
    "credentials"
  ],
  "additionalProperties": false
}
