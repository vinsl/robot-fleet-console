{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "pattern": "^1\\.\\d+\\.\\d+$"
        },
        "messageId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "robotId": {
          "type": "string",
          "pattern": "^[a-z0-9-]{3,32}$"
        },
        "siteId": {
          "type": "string",
          "pattern": "^[a-z0-9-]{3,32}$"
        },
        "ts": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bootId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "commandId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "correlationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{8,64}$"
        },
        "robotTs": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        },
        "state": {
          "type": "string",
          "enum": [
            "IDLE",
            "WORKING",
            "MOVING",
            "CHARGING",
            "BLOCKED",
            "PAUSED",
            "TELEOP",
            "ESTOP"
          ]
        },
        "result": {
          "type": "string",
          "const": "ACK"
        }
      },
      "required": [
        "schemaVersion",
        "messageId",
        "robotId",
        "siteId",
        "ts",
        "seq",
        "bootId",
        "commandId",
        "correlationId",
        "robotTs",
        "state",
        "result"
      ],
      "additionalProperties": false
    },
